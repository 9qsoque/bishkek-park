msgstr "Кечиресиз, сизге %s сайты өчүрүүгө укугуңуз жок."

#: wp-admin/network/sites.php:35
msgid "Dashboard leads to the Dashboard for that site."
msgstr "&laquo;Консоль&raquo; бул сайттын консолуна алып барат."

#: wp-admin/network/sites.php:34
