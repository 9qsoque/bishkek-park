msgstr "&laquo;Өзгөртүү&raquo; &#8212; өзүнчө сайтты түзөтүү экранына шилтеме."

#: wp-admin/network/user-new.php:55
msgid "Cannot add user."
msgstr "Колдонуучу кошууга болбоду."

#: wp-admin/network/user-new.php:22
msgid "Add User will set up a new user account on the network and send that person an email with username and password."
msgstr "Бул экрандан сиз жаңы аккаунтун түзүп, анын ээсине колдонуучу аты жана сырсөз менен e-mail кат жөнөтө аласыз."

#: wp-admin/network/menu.php:46
msgid "Updates"
msgstr "Жаңыртуулар"

#: wp-admin/network/menu.php:116 wp-admin/network/settings.php:21
