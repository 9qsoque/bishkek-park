he template using the settings sidebar.":["\u042d\u043c\u0438 \u0441\u0438\u0437 \u0441\u0430\u0439\u0442\u0442\u044b\u043d \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440\u0443\u043d\u0434\u0430 \u0431\u0430\u0440\u0430\u043a\u0442\u044b\u043d \u043c\u0430\u0437\u043c\u0443\u043d\u0443\u043d \u04e9\u0437\u0433\u04e9\u0440\u0442\u04e9 \u0430\u043b\u0430\u0441\u044b\u0437. \u0411\u0430\u0440\u0430\u043a\u0442\u044b\u043d \u0431\u0430\u0448\u043a\u0430 \u0431\u04e9\u043b\u04af\u043a\u0442\u04e9\u0440\u04af\u043d, \u043c\u0438\u0441\u0430\u043b\u044b, \u04af\u0441\u0442\u04af\u043d\u043a\u04af \u0436\u0430\u043d\u0430 \u0430\u0441\u0442\u044b\u04a3\u043a\u044b \u0431\u04e9\u043b\u04af\u043a\u0442\u04e9\u0440\u04af\u043d \u0442\u0443\u0443\u0440\u0430\u043b\u043e\u043e \u04af\u0447\u04af\u043d, \u043a\u0430\u043f\u0442\u0430\u043b \u0442\u0438\u043b\u043a\u0435\u0441\u0438\u043d\u0438\u043d \u0436\u04e9\u043d\u0434\u04e9\u04e9\u043b\u04e9\u0440\u04af\u043d \u043a\u043e\u043b\u0434\u043e\u043d\u0443\u043f, \u0448\u0430\u0431\u043b\u043e\u043d\u0434\u0443 \u0442\u04af\u0437\u04e9\u0442\u04af\u04af\u0433\u04e9 \u04e9\u0442\u04af\u04a3\u04af\u0437."],"Continue":["\u0423\u043b\u0430\u043d\u0442\u0443\u0443"],"No title":["\u0410\u0442\u0430\u043b\u044b\u0448\u0441\u044b\u0437"],"Editing a page":["\u0411\u0430\u0440\u0430\u043a\u0442\u044b \u0442\u04af\u0437\u04e9\u0442\u04af\u04af"],"Manage the fonts and typography used on captions.":["\u041a\u043e\u043b\u0442\u0430\u043c\u0433\u0430\u043b\u0430\u0440 \u04af\u0447\u04af\u043d \u043a\u043e\u043b\u0434\u043e\u043d\u0443\u043b\u0433\u0430\u043d \u0430\u0440\u0438\u043f\u0442\u0435\u0440\u0434\u0438 \u0436\u0430\u043d\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u044f\u043d\u044b \u0431\u0430\u0448\u043a\u0430\u0440\u044b\u04a3\u044b\u0437."],"Create draft":["\u041a\u0430\u0440\u0430\u043d\u0443\u0441\u043a\u0430 \u0442\u04af\u0437\u04af\u04af"],"Review %d change\u2026":["%d \u04e9\u0437\u0433\u04e9\u0440\u0442\u04af\u04af\u043d\u04af \u043a\u04e9\u0440\u04af\u04af..."],"Activate & Save":["\u0410\u043a\u0442\u0438\u0432\u0434\u0435\u0448\u0442\u0438\u0440\u04af\u04af & \u0421\u0430\u043a\u0442\u043e\u043e"],"No Navigation Menus found.":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443 \u0442\u0430\u0431\u044b\u043b\u0433\u0430\u043d \u0436\u043e\u043a."],"Navigation Menu missing.":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443 \u0436\u043e\u043a."],"Navigation title":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u04af\u0447\u04af\u043d \u0430\u0442\u0430\u043b\u044b\u0448"],"Go to %s":["%s \u04e9\u0442\u04af\u04af"],"Manage what patterns are available when editing the site.":["\u0421\u0430\u0439\u0442\u044b\u04a3\u044b\u0437\u0434\u044b \u0442\u04af\u0437\u04e9\u0442\u04af\u04af\u0434\u04e9 \u043f\u0430\u0442\u0442\u0435\u0440\u043d\u0434\u0435\u0440\u0434\u0438\u043d \u0436\u0435\u0442\u043a\u0438\u043b\u0438\u043a\u0442\u04af\u04af\u043b\u04af\u0433\u04af\u043d \u0431\u0430\u0448\u043a\u0430\u0440\u044b\u04a3\u044b\u0437."],"Unable to rename Navigation Menu (%s).":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443\u043d\u0443\u043d (%s) \u0430\u0442\u044b\u043d \u04e9\u0437\u0433\u04e9\u0440\u0442\u04af\u04af \u043c\u04af\u043c\u043a\u04af\u043d \u044d\u043c\u0435\u0441."],"Renamed Navigation Menu":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443\u043d\u0443\u043d \u0430\u0442\u044b \u04e9\u0437\u0433\u04e9\u0440\u0442\u04af\u043b\u0434\u04af"],"Unable to delete Navigation Menu (%s).":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443\u043d (%s) \u04e9\u0447\u04af\u0440\u04af\u04af \u043c\u04af\u043c\u043a\u04af\u043d \u044d\u043c\u0435\u0441."],"Navigation Menus are a curated collection of blocks that allow visitors to get around your site.":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443 - \u0431\u0443\u043b \u043a\u043e\u043d\u043e\u043a\u0442\u043e\u0440\u0433\u043e \u0441\u0438\u0437\u0434\u0438\u043d \u0441\u0430\u0439\u0442\u043a\u0430 \u0431\u0430\u0433\u044b\u0442\u0442\u043e\u043e\u0433\u043e \u043c\u04af\u043c\u043a\u04af\u043d\u0434\u04af\u043a \u0431\u0435\u0440\u0433\u0435\u043d \u043a\u044b\u043b\u0434\u0430\u0442\u0442\u044b\u043a \u043c\u0435\u043d\u0435\u043d \u0442\u0430\u043d\u0434\u0430\u043b\u0433\u0430\u043d \u0431\u043b\u043e\u043a\u0442\u043e\u0440\u0434\u0443\u043d \u0436\u044b\u0439\u044b\u043d\u0434\u044b\u0441\u044b."],"Are you sure you want to delete this Navigation Menu?":["\u0411\u0443\u043b \u0431\u0430\u0433\u044b\u0442\u0442\u043e\u043e\u043d\u0443 \u04e9\u0447\u04af\u0440\u04af\u04af\u0433\u04e9 \u043c\u0430\u043a\u0443\u043b\u0441\u0443\u0437\u0431\u0443?"],"Manage your Navigation Menus.":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443\u043d \u0431\u0430\u0448\u043a\u0430\u0440\u0443\u0443."],"Unable to duplicate Navigation Menu (%s).":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443\u043d (%s) \u043a\u0430\u0439\u0442\u0430\u043b\u0430\u043f \u043a\u04e9\u0447\u04af\u0440\u04af\u04af \u043c\u04af\u043c\u043a\u04af\u043d \u044d\u043c\u0435\u0441."],"Duplicated Navigation Menu":["\u0411\u0430\u0433\u044b\u0442\u0442\u043e\u043e \u043c\u0435\u043d\u044e\u0441\u0443 \u043a\u0430\u0439\u0442\u0430\u043b\u0430\u043f \u043a\u04e9\u0447\u04af\u0440\u04af\u043b\u0434\u04af"],"E.g. %s":["\u041c\u0438\u0441\u0430\u043b\u044b: %s"],"Select what the new template should apply to:":["\u0416\u0430\u04a3\u044b \u0448\u0430\u0431\u043b\u043e\u043d \u044d\u043c\u043d\u0435\u0433\u0435 \u043a\u043e\u043b\u0434\u043e\u043d\u0443\u043b\u0430\u0440\u044b\u043d \u0442\u0430\u043d\u0434\u0430\u04a3\u044b\u0437:"],"Go to the Dashboard":["\u041a\u043e\u043d\u0441\u043e\u043b\u0433\u043e \u04e9\u0442\u04af\u04af