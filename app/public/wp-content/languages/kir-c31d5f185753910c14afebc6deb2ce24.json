u0442\u04e9\u0440\u04af"],"Template part":["\u0428\u0430\u0431\u043b\u043e\u043d \u0431\u04e9\u043b\u04af\u0433\u04af"],"(no title %s)":["(\u0430\u0442\u0430\u043b\u044b\u0448\u0441\u044b\u0437 %s)"],"Pattern":["\u041f\u0430\u0442\u0442\u0435\u0440\u043d"],"Custom template":["\u041a\u043e\u043b\u0434\u043e\u043d\u0443\u0443\u0447\u0443\u043d\u0443\u043d \u0448\u0430\u0431\u043b\u043e\u043d\u0443"],"Add template: %s":["\u0428\u0430\u0431\u043b\u043e\u043d \u043a\u043e\u0448\u0443\u0443: %s"],"No authors found.":["\u0410\u0432\u0442\u043e\u0440\u043b\u043e\u0440 \u0442\u0430\u0431\u044b\u043b\u0433\u0430\u043d \u0436\u043e\u043a."],"Search Authors":["\u0410\u0432\u0442\u043e\u0440\u043b\u043e\u0440\u0434\u0443 \u0438\u0437\u0434\u04e9\u04e9"],"\"%s\" successfully created.":["\"%s\" \u0438\u0439\u0433\u0438\u043b\u0438\u043a\u0442\u04af\u04af \u0442\u04af\u0437\u04af\u043b\u0434\u04af."],"This template will be used only for the specific item chosen.":["\u0411\u0443\u043b \u0448\u0430\u0431\u043b\u043e\u043d \u0442\u0430\u043d\u0434\u0430\u043b\u0433\u0430\u043d \u0442\u04af\u0440 \u04af\u0447\u04af\u043d \u0433\u0430\u043d\u0430 \u043a\u043e\u043b\u0434\u043e\u043d\u0443\u043b\u0430\u0442."],"For a specific item":["\u0410\u0440 \u0431\u0438\u0440\u0438 \u04af\u0447\u04af\u043d"],"For all items":["\u0411\u0430\u0440\u0434\u044b\u043a \u0442\u04af\u0440\u043b\u04e9\u0440\u04af \u04af\u0447\u04af\u043d"],"Select whether to create a single template for all items or a specific one.":["\u0411\u0430\u0440\u0434\u044b\u043a \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0442\u0435\u0440 \u04af\u0447\u04af\u043d \u0431\u0438\u0440 \u0448\u0430\u0431\u043b\u043e\u043d\u0434\u0443 \u0436\u0435 \u0430\u0440 \u0431\u0438\u0440\u0438 \u04af\u0447\u04af\u043d \u04e9\u0437\u04af\u043d\u0447\u04e9 \u0431\u0438\u0440 \u0448\u0430\u0431\u043b\u043e\u043d\u0434\u0443 \u0442\u04af\u0437\u04af\u04af\u043d\u04af \u0442\u0430\u043d\u0434\u043e\u043e."],"Suggestions list":["\u0421\u0443\u043d\u04